# ---- Mail Provider ----
# 选择临时邮箱后端：cloudflare_temp_email(默认) | cloud-mail | outlook | luckmail
#   - cloudflare_temp_email = dreamhunter2333/cloudflare_temp_email
#   - cloud-mail            = community cloud-mail
#   - outlook               = 已有 Outlook/Hotmail 账号池，注册时逐个取号并读取验证码
#   - luckmail              = LuckMail 已购邮箱 token，格式 email----tok_xxx
MAIL_PROVIDER=cloudflare_temp_email

# cloudflare_temp_email（推荐）
CLOUDFLARE_TEMP_EMAIL_BASE_URL=https://example.com/api
CLOUDFLARE_TEMP_EMAIL_ADMIN_PASSWORD=your_password
CLOUDFLARE_TEMP_EMAIL_DOMAIN=@example.com

# cloud-mail
# CLOUD_MAIL_API_URL=https://your-cloud-mail.example.com
# CLOUD_MAIL_ADMIN_EMAIL=admin@example.com
# CLOUD_MAIL_ADMIN_PASSWORD=your_password
# CLOUD_MAIL_DOMAIN=@example.com

# Outlook 账号池
# 支持格式：
#   email@outlook.com----mail_password
#   email@outlook.com----mail_password----client_id----refresh_token
#   email@outlook.com----https://mailapi.icu/key?type=html&orderNo=xxxx
# 默认也会读取 data/outlook_accounts.txt
OUTLOOK_ACCOUNTS_FILE=data/outlook_accounts.txt
OUTLOOK_ACCOUNTS=
OUTLOOK_DEFAULT_CLIENT_ID=24d9a0ed-8787-4584-883c-2fd79308940a
OUTLOOK_PROVIDER_PRIORITY=imap_old,imap_new,graph_api
OUTLOOK_PROXY_URL=
OUTLOOK_REGISTER_CODE_TIMEOUT=30

# LuckMail 已购邮箱 token 池
# 支持格式：
#   email@outlook.my----tok_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 默认也会读取 data/luckmail_accounts.txt
LUCKMAIL_BASE_URL=https://mail.luckyous.com
LUCKMAIL_ACCOUNTS_FILE=data/luckmail_accounts.txt
LUCKMAIL_ACCOUNTS=
LUCKMAIL_API_KEY=
LUCKMAIL_PROJECT_CODE=openai
LUCKMAIL_EMAIL_TYPE=ms_graph
LUCKMAIL_PREFERRED_DOMAIN=

# 旧字段别名（兼容历史版本，可不再使用）
CLOUDMAIL_BASE_URL=
CLOUDMAIL_PASSWORD=
CLOUDMAIL_DOMAIN=
CLOUDMAIL_EMAIL=
MAILLAB_API_URL=
MAILLAB_USERNAME=
MAILLAB_PASSWORD=
MAILLAB_DOMAIN=

# CPA (CLIProxyAPI)
CPA_URL=http://127.0.0.1:8317
CPA_KEY=your_key

# API 鉴权（不设置则不启用，任何人都可访问）
API_KEY=

# Playwright 浏览器代理（可选）
# 示例：socks5://user:pass@host.docker.internal:1080
PLAYWRIGHT_PROXY_URL=
# 示例：localhost,127.0.0.1
PLAYWRIGHT_PROXY_BYPASS=

# WhatsApp OTP（安卓模拟器 / ADB）
# 选择 GoPay 的 WhatsApp OTP 时，会从本机 adb 连接的模拟器读取 WhatsApp 通知/UI 文本。
# 如果只有一个模拟器，通常不用配置；多个 adb 设备时必须指定 serial。
ANDROID_ADB_PATH=adb
# 示例：emulator-5554
WHATSAPP_ADB_SERIAL=

# GoPay 自动注册（开启“自动注册 GoPay”前必须配置）
# 绑定任务可在执行前自动调用短信服务商注册新的 GoPay 钱包，然后复用同一接码会话继续完成绑定 OTP。
# 支持：hero_sms | smscloud
GOPAY_AUTO_SIGNUP_SMS_PROVIDER=smscloud
GOPAY_AUTO_SIGNUP_HERO_SMS_API_KEY=
GOPAY_AUTO_SIGNUP_HERO_SMS_BASE_URL=https://hero-sms.com/stubs/handler_api.php
GOPAY_AUTO_SIGNUP_HERO_SMS_COUNTRY=6
GOPAY_AUTO_SIGNUP_HERO_SMS_SERVICE=ni
GOPAY_AUTO_SIGNUP_HERO_SMS_TIMEOUT=120
# 可选：hero-sms getNumber 的 maxPrice，例如 0.045；留空则不限价
GOPAY_AUTO_SIGNUP_HERO_SMS_MAX_PRICE=
# smscloud 取号接口实际使用网站登录后的 XI_TOKEN。
GOPAY_AUTO_SIGNUP_SMSCLOUD_XI_TOKEN=
GOPAY_AUTO_SIGNUP_SMSCLOUD_BASE_URL=https://smscloud.sbs/api
GOPAY_AUTO_SIGNUP_SMSCLOUD_COUNTRY=6
GOPAY_AUTO_SIGNUP_SMSCLOUD_SERVICE=ni
GOPAY_AUTO_SIGNUP_SMSCLOUD_MAX_PRICE=
GOPAY_AUTO_SIGNUP_SMSCLOUD_TIMEOUT=120
GOPAY_AUTO_SIGNUP_COUNTRY_CODE=+62
GOPAY_AUTO_SIGNUP_DEFAULT_PIN=558023
# 自动注册 GoPay 钱包时，遇到已存在钱包等可换号失败最多取号次数
GOPAY_AUTO_SIGNUP_WALLET_ATTEMPTS=10
# 批量 GoPay 自动注册绑定时，后台提前准备的钱包数量。0=关闭，建议 1；最多 2。
GOPAY_AUTO_SIGNUP_PREFETCH_WALLETS=1
# 可选：如果不传任务级代理，自动注册会回退到这里
GOPAY_AUTO_SIGNUP_PROXY_URL=

# Rekberinaja GoPay 充值（可选）
# REKBERINAJA_TRANSFER_ENABLED 默认关闭。关闭时自动注册 GoPay 钱包完成 PIN 设置后先等待 60s 再首次绑定；若疑似 1rp 未到账，会复用同一钱包延长等待重试。
# 开启后，自动注册 GoPay 钱包完成后会先用 Rekberinaja 站内余额充值最低 GoPay 面额，再继续绑定。
REKBERINAJA_ENABLED=0
REKBERINAJA_TRANSFER_ENABLED=0
REKBERINAJA_EMAIL=
REKBERINAJA_PASSWORD=
REKBERINAJA_BASE_URL=https://api.rekberinaja.com/api
REKBERINAJA_STORE=rekberinaja
# 默认是 Topup GOPAY / Go Pay 1.000
REKBERINAJA_GOPAY_PRODUCT_ID=5668ba3f-9b70-409d-9079-e0aafa798e69
REKBERINAJA_GOPAY_SERVICE_ID=81b3fe9a-13ee-11f1-aa7e-c81f66de8b22
REKBERINAJA_MIN_BALANCE=5000
REKBERINAJA_POLL_INTERVAL=5
REKBERINAJA_POLL_TIMEOUT=180
REKBERINAJA_INVOICE_EMAIL=
# 免转账模式：PIN 设置完成后的首次等待，以及余额未到账类失败后的延长等待重试队列。不会因为 60s 未到账就直接丢弃钱包。
GOPAY_AUTO_SIGNUP_NO_TRANSFER_BIND_WAIT_SECONDS=60
GOPAY_AUTO_SIGNUP_NO_TRANSFER_RETRY_WAITS=30,60,120
GOPAY_SMS_CHANNEL_SWITCH_ENABLED=1
GOPAY_SMS_CHANNEL_SWITCH_DELAY_SECONDS=30
# GoPay 绑定 OTP：最多等待 180s，最多重发 2 次；仍未收到则切换下一个账号/号码。
GOPAY_BIND_SMS_OTP_TIMEOUT_SECONDS=180
GOPAY_BIND_SMS_OTP_MAX_RESEND_ATTEMPTS=2

# 注册成功后的 Codex OAuth 模式
# protocol：默认，复用 auth_session 走纯协议 OAuth，不打开浏览器
# chrome_cdp：只使用真实 Chrome CDP
# windows_ui：控制 Windows 桌面 Chrome（实验性）
# playwright/browser/session_browser：旧 Playwright auth_session 流程
OAUTH_BROWSER_MODE=protocol
# 启动 Chrome 示例：
# chrome.exe --remote-debugging-port=9222 --user-data-dir=D:\code\OpenSource\AutoTeam-F\data\chrome-oauth-profile
OAUTH_CHROME_CDP_URL=http://127.0.0.1:9222
OAUTH_CHROME_CDP_TIMEOUT=240
# 注册成功后是否立刻自动执行 Codex OAuth。默认关闭，只保存 auth_session。
POST_REGISTER_OAUTH_ENABLED=false
# 可选：协议注册模块目录。留空时只启用浏览器注册。
AUTOTEAM_PROTOCOL_REGISTER_DIR=

# 轮询配置
EMAIL_POLL_INTERVAL=3
EMAIL_POLL_TIMEOUT=300

# 自动巡检（API 模式下生效）
AUTO_CHECK_INTERVAL=300      # 巡检间隔（秒），默认 5 分钟
AUTO_CHECK_THRESHOLD=10      # 额度低于此百分比触发轮转，默认 10%
AUTO_CHECK_MIN_LOW=2         # 至少几个账号低于阈值才触发，默认 2

# 对账策略（autoteam reconcile / cmd_check 入口自动对账）
# RECONCILE_KICK_ORPHAN=true：workspace 有 active + 本地 auth_file 缺失的"残废"自动 KICK
#                        false：只标 STATUS_ORPHAN，等人工补登
RECONCILE_KICK_ORPHAN=true
# RECONCILE_KICK_GHOST=true：workspace 有 active + 本地完全无记录的"ghost"自动 KICK
#                       false：仅日志，依赖 sync_account_states 反向补录
RECONCILE_KICK_GHOST=true
