--- paypal/country_profile.py	1970-01-01 08:00:00
+++ paypal/country_profile.py	2026-07-23 20:54:23
@@ -0,0 +1,24 @@
+from __future__ import annotations
+from dataclasses import dataclass
+
+@dataclass(frozen=True)
+class CountryProfile:
+    country: str
+    locale: str
+    language: str
+    phone_country_code: str
+    kyc_fields: tuple[str, ...] = ()
+    collect_card_product_class: bool = False
+    card_dob_required: bool = False
+
+    @property
+    def content_language(self) -> str:
+        return self.language.split('-', 1)[0].lower()
+
+COUNTRY_PROFILES: dict[str, CountryProfile] = {
+    "US": CountryProfile("US", "en_US", "en-US", "1", (), False, False),
+    "BR": CountryProfile("BR", "pt_BR", "pt-BR", "55", ("DateOfBirth", "IdentityDocumentType", "IdentityDocumentNumber"), True, True),
+}
+
+def get_country_profile(country: str | None) -> CountryProfile:
+    return COUNTRY_PROFILES.get((country or "BR").upper(), COUNTRY_PROFILES["BR"])
