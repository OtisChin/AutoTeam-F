@@ -0,0 +1,86 @@
+from __future__ import annotations
+from dataclasses import dataclass
+
+@dataclass(frozen=True)
+class CountryProfile:
+    country: str
+    locale: str
+    language: str
+    phone_country_code: str
+    kyc_fields: tuple[str, ...] = ()
+    collect_card_product_class: bool = False
+    card_dob_required: bool = False
+    default_address_line2: bool = False
+
+    @property
+    def content_language(self) -> str:
+        return self.language.split('-', 1)[0].lower()
+
+COUNTRY_PROFILES: dict[str, CountryProfile] = {
+    # Source-map evidence: kycFields.US=[], CARD_FIELDS_TO_DISPLAY.dob=false,
+    # shouldCollectCardProductClass only true for BR.
+    "US": CountryProfile(
+        country="US",
+        locale="en_US",
+        language="en-US",
+        phone_country_code="1",
+        kyc_fields=(),
+        collect_card_product_class=False,
+        card_dob_required=False,
+    ),
+    "BR": CountryProfile(
+        country="BR",
+        locale="pt_BR",
+        language="pt-BR",
+        phone_country_code="55",
+        kyc_fields=("DateOfBirth", "IdentityDocumentType", "IdentityDocumentNumber"),
+        collect_card_product_class=True,
+        card_dob_required=True,
+        default_address_line2=True,
+    ),
+}
+
+def get_country_profile(country: str | None) -> CountryProfile:
+    return COUNTRY_PROFILES.get((country or "BR").upper(), COUNTRY_PROFILES["BR"])
