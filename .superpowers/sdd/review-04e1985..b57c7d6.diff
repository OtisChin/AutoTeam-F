+
+    assert updated["email"] == "one@mail.com"
+    assert updated["gpt_password"] == "new-gpt"
+    assert updated["refresh_token"] == "rt-new"
+    assert updated["check_status"] == "valid"
+    assert "已注册" in updated["note"]
