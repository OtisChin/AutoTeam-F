+                    "totp_status": status,
+                    "totp_secret": normalized_secret,
+                    "totp_secret_masked": mask_totp_secret(normalized_secret),
+                    "totp_otpauth_uri": str(otpauth_uri or ""),
+                    "totp_issuer": str(issuer or ""),
