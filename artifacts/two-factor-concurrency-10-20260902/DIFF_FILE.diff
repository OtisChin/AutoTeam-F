+def test_protocol_setup_runs_accounts_with_ten_workers():
+    emails = [f"user-{index}@example.com" for index in range(12)]
+    accounts = [{"email": email, "two_factor_enabled": False} for email in emails]
+    lock = threading.Lock()
+    active = 0
+    peak_active = 0
+
+    class ConcurrentExecutor:
+        def __init__(self, **_kwargs):
+            pass
+
+        def enable(self, email, session_data, *, progress=None):
+            nonlocal active, peak_active
+            assert session_data == {"sessionToken": f"session:{email}"}
+            with lock:
+                active += 1
+                peak_active = max(peak_active, active)
+            time.sleep(0.03)
+            with lock:
+                active -= 1
+            return ChatGPT2FASetupResult(ChatGPT2FASetupStatus.ENABLED, email, masked_secret="ABCD…WXYZ")
+
+    result = account_two_factor.setup_accounts_two_factor_protocol(
+        emails,
+        accounts_loader=lambda: accounts,
+        session_loader=lambda email: {"sessionToken": f"session:{email}"},
+        mail_client_factory=lambda _account: _MailClient(),
+        executor_factory=lambda **kwargs: ConcurrentExecutor(**kwargs),
+        save_metadata=lambda **_kwargs: None,
+        otp_waiter=lambda *_args, **_kwargs: "123456",
+    )
+
+    assert result["total"] == 12
+    assert len(result["enabled"]) == 12
+    assert peak_active == 10
 
 
