# Copy this file to your target project and replace placeholders.
OAUTH_RELOGIN_CLIENT_ID=REPLACE_WITH_OAUTH_CLIENT_ID
OAUTH_RELOGIN_AUTH_URL=https://auth.example.com/oauth/authorize
OAUTH_RELOGIN_TOKEN_URL=https://auth.example.com/oauth/token
OAUTH_RELOGIN_REDIRECT_URI=http://127.0.0.1:1455/auth/callback
OAUTH_RELOGIN_SCOPE=openid email profile offline_access
OAUTH_RELOGIN_SESSION_COOKIE_NAME=__Secure-next-auth.session-token
OAUTH_RELOGIN_AUTH_DOMAINS=auth.example.com,.auth.example.com

# Generic selected Phone/SMS provider
OAUTH_RELOGIN_PHONE_SMS_PROVIDER=phone_pool
OAUTH_RELOGIN_PHONE_SMS_COUNTRY=US
OAUTH_RELOGIN_PHONE_SMS_SERVICE=dr
OAUTH_RELOGIN_PHONE_SMS_API_KEY=
OAUTH_RELOGIN_PHONE_SMS_BASE_URL=
OAUTH_RELOGIN_PHONE_SMS_MAX_PRICE=
OAUTH_RELOGIN_PHONE_SMS_POLL_ATTEMPTS=24
OAUTH_RELOGIN_PHONE_SMS_POLL_INTERVAL_SECONDS=5

# hero-sms
OAUTH_RELOGIN_HERO_SMS_API_KEY=
OAUTH_RELOGIN_HERO_SMS_BASE_URL=https://hero-sms.example/stubs/handler_api.php
